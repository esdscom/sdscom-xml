										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="ResultEvaluation" type="eSDScom:Phrase"/>
									<xs:element maxOccurs="1" minOccurs="0" name="TestReference" type="eSDScom:Phrase"/>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element maxOccurs="1" minOccurs="0" name="HumanExperience">
							<xs:annotation>
								<xs:documentation>Human experience for the relevant toxicological endpoint.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="RespiratorySensitisationHumanExperience" type="eSDScom:Phrase">
										<xs:annotation>
											<xs:documentation>Human experience on respiratory sensitisation.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="SkinSensitisationHumanExperience" type="eSDScom:Phrase">
										<xs:annotation>
											<xs:documentation>Human experience on skin sensitisation.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element maxOccurs="1" minOccurs="0" name="ClassificationAssessment">
							<xs:annotation>
								<xs:documentation>Classification assessment for the relevant toxicological endpoint.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="AssessmentRespiratorySensitisationClassification" type="eSDScom:Phrase">
										<xs:annotation>
											<xs:documentation>Assessment of classification for respiratory sensitisation under CLP/GHS.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="AssessmentSkinSensitisationClassification" type="eSDScom:Phrase">
										<xs:annotation>
											<xs:documentation>Assessment of classification for skin sensitisation under CLP/GHS.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="GermCellMutagenicity">
				<xs:annotation>
					<xs:documentation>Information on germ cell mutagenicity, including classification and test results.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="TestResults">
							<xs:complexType>
								<xs:sequence>
									<xs:element maxOccurs="1" minOccurs="1" name="InvestigationMethod" type="eSDScom:InvestigationMethod"/>
									<xs:element maxOccurs="1" minOccurs="1" name="Method" type="eSDScom:Phrase"/>
									<xs:element maxOccurs="1" minOccurs="0" name="EffectValue" type="eSDScom:NumericRangeWithUnitAndQualifier"/>
									<xs:element maxOccurs="1" minOccurs="0" name="TestDuration" type="eSDScom:NumericRangeWithUnitAndQualifier"/>
									<xs:element maxOccurs="1" minOccurs="0" name="ExposureRoute" type="eSDScom:ExposureRoute"/>
									<xs:element maxOccurs="1" minOccurs="0" name="Dose" type="eSDScom:NumericRangeWithUnitAndQualifier"/>
									<!-- Was Phrase -->
									<xs:element maxOccurs="1" minOccurs="0" name="ExposureTime" type="eSDScom:NumericRangeWithUnitAndQualifier"/>
									<xs:element maxOccurs="1" minOccurs="1" name="Species" type="eSDScom:Species">
										<xs:annotation>
											<xs:documentation> Species = Organism or cell line </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="1" minOccurs="0" name="GeneticEndpoint" type="eSDScom:Phrase"/>
									<xs:element maxOccurs="1" minOccurs="0" name="Result" type="eSDScom:NumericRangeWithUnitAndQualifier"/>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="ResultEvaluation" type="eSDScom:Phrase"/>
									<xs:element maxOccurs="1" minOccurs="0" name="TestReference" type="eSDScom:Phrase"/>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="GermCellMutagenicityHumanExperience" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>Human experience on germ cell mutagenicity; qualitative informationn.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AssessmentGermCellMutagenicityClassification" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>Assessment of classification on germ cell mutagenicity under CLP/GHS.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
