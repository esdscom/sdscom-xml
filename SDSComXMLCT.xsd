	<xs:complexType name="BaseToxicologicalInformation">
		<xs:annotation>
			<xs:appinfo>SDScomChem</xs:appinfo>
			<xs:documentation>Used in SDS section 11. Also used in "Component"</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element maxOccurs="1" minOccurs="0" name="ToxicokineticInfo">
				<xs:annotation>
					<xs:documentation>Information on absorption, distribution, metabolism and excretion.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="NonHumanToxicologicalData">
							<xs:annotation>
								<xs:documentation>Toxicological data from animal studies, in vitro or other non-human sources.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element maxOccurs="1" minOccurs="0" name="Method" type="eSDScom:Phrase">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="1" minOccurs="0" name="Species" type="eSDScom:Species">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation>test organism or species in the toxicological/ecotoxicological test.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="1" minOccurs="1" name="Dose" type="eSDScom:Dose">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation>dose in the toxicological test; unit e.g. mg/kg KG or mg/L.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="1" minOccurs="0" name="ExposureRoute" type="eSDScom:ExposureRoute">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation>Route of exposure in the toxicological test, e.g. oral, dermal or inhalation.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="Results" type="eSDScom:Phrase">
										<xs:annotation>
											<xs:documentation>Results of a test or assessment; unit depends on context.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="HumanToxicologicalData" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>Human toxicological data or experience reports.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="AcuteToxicity">
				<xs:annotation>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation>Acute toxicity by oral, dermal or inhalation route; unit e.g. mg/kg or mg/L/4h.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="TestResults">
							<xs:annotation>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation>e.g. LD50 and ATEmix values</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element maxOccurs="1" minOccurs="1" name="EffectTested" type="eSDScom:Dose">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation>Tested toxicological effect or endpoint.</xs:documentation>
