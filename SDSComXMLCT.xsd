								<xs:documentation>Assessment of classification for eye damage/eye irritation under CLP/GHS.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="RespiratoryOrSkinSensitisation">
				<xs:annotation>
					<xs:documentation>Information on respiratory or skin sensitisation.</xs:documentation>
				</xs:annotation>
