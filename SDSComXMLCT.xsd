				<xs:annotation>
					<xs:documentation>Information on phototoxicity or phototoxic reaction.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="PhototoxicityTestResults">
							<xs:annotation>
								<xs:documentation>test results on phototoxicity.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element maxOccurs="1" minOccurs="1" name="InvestigationMethod" type="eSDScom:InvestigationMethod"/>
									<xs:element maxOccurs="1" minOccurs="0" name="TestMethod" type="eSDScom:Phrase">
										<xs:annotation>
											<xs:documentation>test method or test guideline, e.g. OECD or internal method.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<!-- xs:element name="Dose" type="DoseEnum" minOccurs="0" maxOccurs="1"/ -->
									<xs:element maxOccurs="1" minOccurs="0" name="Dose" type="eSDScom:NumericRangeWithUnitAndQualifier"/>
									<xs:element maxOccurs="1" minOccurs="1" name="ExposureRoute" type="eSDScom:ExposureRoute"/>
									<xs:element maxOccurs="1" minOccurs="0" name="TestDuration" type="eSDScom:NumericRangeWithUnitAndQualifier"/>
									<xs:element maxOccurs="1" minOccurs="1" name="Results">
										<!-- Was Result -->
										<xs:complexType>
											<xs:sequence>
												<xs:element maxOccurs="1" minOccurs="0" name="Value" type="eSDScom:NumericRangeWithUnitAndQualifier"/>
												<xs:element maxOccurs="1" minOccurs="0" name="PhotoIrritationFactor" type="eSDScom:NumericRangeWithUnitAndQualifier">
													<xs:annotation>
														<xs:documentation>Photo irritation factor (PIF); dimensionless.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element maxOccurs="1" minOccurs="0" name="MeanPhotoEffect" type="eSDScom:NumericRangeWithUnitAndQualifier">
													<xs:annotation>
														<xs:documentation>Mean photo effect in phototoxicity test; dimensionless or method-dependent.</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element maxOccurs="unbounded" minOccurs="0" name="Evaluation" type="eSDScom:Phrase"/>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element maxOccurs="1" minOccurs="0" name="Species" type="eSDScom:Species"/>
									<xs:element maxOccurs="1" minOccurs="0" name="TestReference" type="eSDScom:Phrase"/>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="unbounded" minOccurs="0" name="EndocrineDisruption" type="eSDScom:Phrase">
				<xs:annotation>
					<xs:documentation>Information on endocrine-disrupting properties for humans or the environment.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="BaseEcologicalInformation">
		<xs:annotation>
			<xs:appinfo>SDScomChem</xs:appinfo>
			<xs:documentation>Used in SDS section 12. Also used in "Component" </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element maxOccurs="1" minOccurs="0" name="EcotoxicologicalInformation">
				<xs:annotation>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation>Information on environmental toxicity to aquatic, sediment or soil organisms.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element minOccurs="0" name="AquaticToxicity">
							<xs:annotation>
								<xs:documentation>Information on acute or chronic aquatic toxicity; unit typically mg/L.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="AcuteFishToxicity" type="eSDScom:EcotoxicityAquatic">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation>Acute toxicity to fish; endpoint e.g. LC50, unit mg/L.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="ChronicFishToxicity" type="eSDScom:EcotoxicityAquatic">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation>Chronic toxicity to fish; endpoint e.g. NOEC/EC10, unit mg/L.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="AcuteInvertebrateToxicity" type="eSDScom:EcotoxicityAquatic">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation>Acute toxicity to aquatic invertebrates; endpoint e.g. EC50, unit mg/L.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="ChronicInvertebrateToxicity" type="eSDScom:EcotoxicityAquatic">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation>Chronic toxicity to aquatic invertebrates; endpoint e.g. NOEC/EC10, unit mg/L.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="AcuteAlgaeToxicity" type="eSDScom:EcotoxicityAquatic">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation>Acute toxicity to algae or aquatic plants; endpoint e.g. EC50, unit mg/L.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="ChronicAlgaeToxicity" type="eSDScom:EcotoxicityAquatic">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation>Chronic toxicity to algae or aquatic plants; endpoint e.g. NOEC/EC10, unit mg/L.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="PlantToxicity" type="eSDScom:EcotoxicityAquatic">
										<xs:annotation>
											<xs:documentation>Toxicity to plants; endpoint and unit depend on the test, e.g. mg/kg soil or mg/L.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="MicroorganismToxicity" type="eSDScom:EcotoxicityAquatic">
										<xs:annotation>
											<xs:documentation>Toxicity to microorganisms, e.g. sewage treatment organisms; unit typically mg/L.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="SedimentToxicity" type="eSDScom:Ecotoxicity">
							<xs:annotation>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation>Toxicity to sediment organisms; unit typically mg/kg Sediment or mg/L.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element minOccurs="0" name="TerrestrialToxicity">
							<xs:annotation>
								<xs:documentation>Toxicity to terrestrial organisms; unit typically mg/kg soil.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="SoilMicroorganismsToxicity" type="eSDScom:Ecotoxicity">
										<xs:annotation>
											<xs:documentation>Toxicity to soil microorganisms; unit depends on the test, e.g. mg/kg soil.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="AcuteEarthwormToxicity" type="eSDScom:Ecotoxicity">
										<xs:annotation>
											<xs:documentation>Acute toxicity to earthworms; endpoint e.g. LC50, unit mg/kg soil.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="ChronicEarthwormToxicity" type="eSDScom:Ecotoxicity">
										<xs:annotation>
											<xs:documentation>Chronic toxicity to earthworms; endpoint e.g. NOEC, unit mg/kg soil.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="InsectToxicity" type="eSDScom:Ecotoxicity">
										<xs:annotation>
											<xs:documentation>Toxicity to insects; endpoint and unit depend on the test method.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="AcutePlantToxicity" type="eSDScom:Ecotoxicity">
										<xs:annotation>
											<xs:documentation>Acute toxicity to terrestrial plants; unit typically mg/kg soil.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="ChronicPlantToxicity" type="eSDScom:Ecotoxicity">
										<xs:annotation>
											<xs:documentation>Chronic toxicity to terrestrial plants; endpoint e.g. NOEC/EC10, unit mg/kg soil.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="AcuteSubchronicBirdToxicity" type="eSDScom:Ecotoxicity">
										<xs:annotation>
											<xs:documentation>Acute/subchronic toxicity to birds; endpoint and unit depend on the test method.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="BirdReproductionToxicity" type="eSDScom:Ecotoxicity">
										<xs:annotation>
											<xs:documentation>Bird reproduction toxicity; endpoint and unit depend on the test method.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="EcotoxicologyOverallEvaluation" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>Overall assessment of ecotoxicological properties and relevance for environmental hazards.</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="PersistenceDegradability">
				<xs:annotation>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation>Information on persistence and degradability; includes biological and abiotic degradation processes.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="BiologicalDegradability" type="eSDScom:BiologicalDegradation">
							<xs:annotation>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation>Biodegradability by microorganisms; unit e.g. % degradation after a defined period (d).</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AbioticDegradation" type="eSDScom:DegradationElimination">
							<xs:annotation>
								<xs:documentation>Abiotic degradation by non-biological processes, e.g. hydrolysis, photolysis or oxidation; where applicable half-life time</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="PersistenceDegradabilityEvaluation" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>Assessment of persistence and degradability based on available biological and abiotic data.</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="Bioaccumulation">
				<xs:annotation>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation>Information on accumulation in organisms, e.g. BCF, log Kow or bioaccumulation assessment.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="BioconcentrationFactor">
							<xs:annotation>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation>Bioconcentration factor (BCF); dimensionless or L/kg, depending on method and data.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element maxOccurs="1" minOccurs="0" name="Value" type="eSDScom:NumericRangeWithUnitAndQualifier">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="1" minOccurs="0" name="Species" type="eSDScom:Species">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="1" minOccurs="0" name="Method" type="eSDScom:Phrase">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="1" minOccurs="0" name="TestReference" type="eSDScom:Phrase">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="BioaccumulationEvaluation" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation>Assessment of bioaccumulation potential based on available data, e.g. BCF or log Kow.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:appinfo>SDScomChem</xs:appinfo>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="unbounded" minOccurs="0" name="Mobility">
				<xs:annotation>
					<xs:documentation>Information on mobility in environmental compartments, e.g. soil/water distribution or adsorption.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element minOccurs="0" name="Distribution" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>Distribution in environmental compartments or media; information e.g. soil, water, air, sediment.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element minOccurs="0" name="TransportType" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>type of environmental transport or pathway, e.g. water, soil, air or sediment.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="Result" type="eSDScom:PhysChemValue"/>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="Source" type="eSDScom:Phrase"/>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="MobilityEvaluation" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>Assessment of environmental mobility, e.g. based on sorption, solubility or partition coefficients.</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="OtherAdverseEffects">
				<xs:annotation>
					<xs:documentation>Other adverse environmental effects, not already covered by standard endpoints.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="OzoneDepletionPotential" type="eSDScom:PhysChemUnitValue">
							<xs:annotation>
								<xs:documentation>a.k.a. ODP</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="PhotochemicalOzoneCreationPotential" type="eSDScom:PhysChemUnitValue">
							<xs:annotation>
								<xs:documentation>a.k.a. POCP</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="GlobalWarmingPotential" type="eSDScom:PhysChemUnitValue">
							<xs:annotation>
								<xs:documentation>a.k.a. GWP</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AtmosphericLifetime" type="eSDScom:PhysChemUnitValue">
							<xs:annotation>
								<xs:documentation>Atmospheric lifetime of a substance; unit typically hours (h), days (d) or years (a).</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="EndocrineDisruptingPotential" type="eSDScom:PhysChemUnitValue">
							<xs:annotation>
								<xs:documentation>Assessment of potential endocrine-disrupting properties for humans or the environment.</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element minOccurs="0" name="AdditionalEcotoxInformation">
				<xs:annotation>
					<xs:documentation>Additional ecotoxicological parameters or assessments, beyond standard information.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="DissolvedOrganicCarbon" type="eSDScom:FurtherEcologicalData">
							<xs:annotation>
								<xs:documentation>a.k.a. DOC</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="TheoreticalOxygenDemand" type="eSDScom:FurtherEcologicalData">
							<xs:annotation>
								<xs:documentation>a.k.a. ThOD</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="TheoreticalCarbonDioxideAmount" type="eSDScom:FurtherEcologicalData">
							<xs:annotation>
								<xs:documentation>a.k.a. ThCO2</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="ChemicalOxygenDemand" type="eSDScom:FurtherEcologicalData">
							<xs:annotation>
								<xs:documentation>a.k.a. COD</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="BiochemicalOxygenDemand" type="eSDScom:FurtherEcologicalData">
							<xs:annotation>
								<xs:documentation>a.k.a. BOD</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="Bod5CodRatio" type="eSDScom:PhysChemValue">
							<xs:annotation>
								<xs:documentation>BOD5/COD ratio as an indicator of biodegradability; dimensionless.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="TotalOrganicCarbon" type="eSDScom:FurtherEcologicalData">
							<xs:annotation>
								<xs:documentation>a.k.a. TOC</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="InorganicCarbon" type="eSDScom:FurtherEcologicalData">
							<xs:annotation>
								<xs:documentation>a.k.a. IC</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AOXAdsorbableOrganohalogens" type="eSDScom:PhysChemUnitValue">
							<xs:annotation>
								<xs:documentation>AOX, adsorbable organically bound halogens; unit typically mg/L or mg/kg.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="POXPurgeableOrganohalogens" type="eSDScom:PhysChemUnitValue">
							<xs:annotation>
								<xs:documentation>POX, purgeable organically bound halogens; unit typically µg/L or mg/L.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="EOXExtractableOrganohalogens" type="eSDScom:PhysChemUnitValue">
							<xs:annotation>
								<xs:documentation>EOX, extractable organically bound halogens; unit typically mg/kg.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInformation" type="eSDScom:Phrase"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element minOccurs="0" name="RegionEU">
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="1" minOccurs="0" name="ResultsOfPbtAndVpvbAssessment" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>There is no such info for mixtures as a whole. So this should be used only in instances for Components, or for substance SDSs.</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
