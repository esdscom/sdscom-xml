***************************************************************************** -->
<xs:schema targetNamespace="http://www.esdscom.eu/eSDScom" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:eSDScom="http://www.esdscom.eu/eSDScom" xmlns:xs="http://www.w3.org/2001/XMLSchema" version="5.6">
	<xs:include schemaLocation="SDSComXMLDT.xsd"/>
	<xs:include schemaLocation="SDSComXMLNE_AR.xsd"/>
	<xs:include schemaLocation="SDSComXMLNE_AT.xsd"/>
	<xs:include schemaLocation="SDSComXMLNE_BR.xsd"/>
	<xs:include schemaLocation="SDSComXMLNE_CA.xsd"/>
	<xs:include schemaLocation="SDSComXMLNE_CN.xsd"/>
	<xs:include schemaLocation="SDSComXMLNE_DK.xsd"/>
	<xs:include schemaLocation="SDSComXMLNE_EU.xsd"/>
	<xs:include schemaLocation="SDSComXMLNE_GB.xsd"/>
	<xs:include schemaLocation="SDSComXMLNE_JP.xsd"/>
	<xs:include schemaLocation="SDSComXMLNE_MX.xsd"/>
	<xs:include schemaLocation="SDSComXMLNE_NO.xsd"/>
	<xs:include schemaLocation="SDSComXMLNE_RU.xsd"/>
	<xs:include schemaLocation="SDSComXMLNE_TR.xsd"/>
	<xs:include schemaLocation="SDSComXMLNE_US.xsd"/>
	<xs:complexType name="SdsSupplierInfo">
		<xs:sequence>
			<xs:element minOccurs="0" name="SdsName" type="eSDScom:string512">
				<xs:annotation>
					<xs:appinfo>SDScomBau</xs:appinfo>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation>Name of the SDS. Shall be identical with the name on the hazard label and package unless the SDS is a group SDS, in which case the hazard label name must match one of the instances of TradeProductIdentity. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element maxOccurs="unbounded" minOccurs="0" name="SdsNotLegallyRequired" type="eSDScom:Phrase">
				<xs:annotation>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation> SDS not legally required: The formal requirements to SDSs do not apply to chemicals that legally do not require such documents. In this field, the reason for no legal requirement for an SDS can be stated. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="VersionNo" type="eSDScom:string10">
				<xs:annotation>
					<xs:appinfo>SDScomBau</xs:appinfo>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation>Version No: The current version of the SDS document.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IssueDate" type="date">
				<xs:annotation>
					<xs:appinfo>SDScomBau</xs:appinfo>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation> Date of issue: The date when this SDS was prepared for the first time. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="RevisionDate" type="date">
				<xs:annotation>
					<xs:appinfo>SDScomBau</xs:appinfo>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation>Date of revision: The date of the last revision of the SDS document. See also EditingDate.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="EditingDate" type="date">
				<xs:annotation>
					<xs:documentation>If the exporting system is the SDS authoring system, the value of EditingDate should be omitted or be equal to RevisionDate. If the export is prepared by another system, e.g. from a service provider, the EditingDate is the status of data entry of the SDS and is equal to or larger than RevisionDate.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="DistributionStoppedDate" type="date">
				<xs:annotation>
					<xs:appinfo>SDScomBau</xs:appinfo>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation>Date when manufacturer stopped distribution. See also ProductDiscontinuedFromMarket.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element maxOccurs="unbounded" name="SupplierInformation">
				<xs:annotation>
					<xs:appinfo>SDScomBau</xs:appinfo>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation> Supplier information: Contact information etc. on relevant actors in the supply chain. </xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="1" minOccurs="0" name="Role">
							<xs:annotation>
								<xs:appinfo>SDScomBau</xs:appinfo>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation> Description of role: To describe an actor’s role. </xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element maxOccurs="1" minOccurs="0" name="RoleCode" type="eSDScom:RoleDescriptionEnum">
										<xs:annotation>
											<xs:appinfo>SDScomBau</xs:appinfo>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation> Description of role: To describe an actor’s role. Accepted values: Responsible company, National responsible, Manufacturer, Importer, Only representative, Reimporter, Formulator, Distributor, Downstream user, Foreign manufacturer </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="RoleDescription" type="eSDScom:Phrase">
										<xs:annotation>
											<xs:documentation> Role description: Textual description of the role code. To allow language independent description in addition to English based role codes. </xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element minOccurs="1" name="Country" type="eSDScom:CountryCodeEnum">
							<xs:annotation>
								<xs:documentation>This country informaion applies to all addresses and contacts and LegalRegistrationNumber within SupplierInformation.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="1" minOccurs="1" name="Name" type="eSDScom:string256">
							<xs:annotation>
								<xs:appinfo>SDScomBau</xs:appinfo>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation> Name: Name of the company </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="1" minOccurs="1" name="Address">
							<xs:annotation>
								<xs:appinfo>SDScomBau</xs:appinfo>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation>Address of the supplier, importer or contact person.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element minOccurs="0" name="VisitingAddressLine1" type="eSDScom:string256">
										<xs:annotation>
											<xs:documentation>First line of the visiting address.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="VisitingAddressLine2" type="eSDScom:string256">
										<xs:annotation>
											<xs:documentation>Second line of the visiting address.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="VisitingAddressLine3" type="eSDScom:string256">
										<xs:annotation>
											<xs:documentation>Third line of the visiting address.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="VisitingAddressPostCode" type="eSDScom:string16">
										<xs:annotation>
											<xs:documentation> Postal code: Two-letter ISO3166 country code followed by a hyphen and the national postal code. </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="VisitingAddressCity" type="eSDScom:string80">
										<xs:annotation>
											<xs:documentation>city of the visiting address.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="PostAddressLine1" type="eSDScom:string256">
										<xs:annotation>
											<xs:appinfo>SDScomBau</xs:appinfo>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation> Postal address: P.O.Box or street address </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="PostAddressLine2" type="eSDScom:string256">
										<xs:annotation>
											<xs:appinfo>SDScomBau</xs:appinfo>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation>Second line of the postal address.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="PostAddressLine3" type="eSDScom:string256">
										<xs:annotation>
											<xs:appinfo>SDScomBau</xs:appinfo>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation>Third line of the postal address.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="PostCode" type="eSDScom:string16">
										<xs:annotation>
											<xs:appinfo>SDScomBau</xs:appinfo>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation> Postal code: Two-letter ISO3166 country code followed by a hyphen and the national postal code. </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="PostCity" type="eSDScom:string80">
										<xs:annotation>
											<xs:appinfo>SDScomBau</xs:appinfo>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation> Postal city: </xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="1" name="Phone" type="eSDScom:string256">
							<xs:annotation>
								<xs:appinfo>SDScomBau</xs:appinfo>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation> Telephone number: </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="Fax" type="eSDScom:string256">
							<xs:annotation>
								<xs:appinfo>SDScomBau</xs:appinfo>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation> Faximile number: </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="Email" type="eSDScom:EmailAddress">
							<xs:annotation>
								<xs:appinfo>SDScomBau</xs:appinfo>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation> e-mail address to the company: </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="1" minOccurs="0" name="CompanyUrl" type="eSDScom:URL">
							<xs:annotation>
								<xs:appinfo>SDScomBau</xs:appinfo>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation> Company URL: Web address to the company’s home page </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="CompanyContact">
							<xs:annotation>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation> Company contact: This field covers all contact persons related to the company. Department or person within the company that can be contacted regarding information on the actual chemical. </xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element minOccurs="0" name="Name" type="eSDScom:string512">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation> Name: Name of the company contact </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="Phone" type="eSDScom:string256">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation> Telephone number: Telephone number of the company contact </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="Fax" type="eSDScom:string256">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation> Faximile number: Faximile number of the company contact </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="Url" type="eSDScom:URL">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation> URL: Web addressof the company contact </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="Email" type="eSDScom:EmailAddress">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation> e-mail address: e-mail address of the company contact </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="NationalContact" type="eSDScom:string256">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation>National contact person or contact point for regional requirements.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="EmailCompetentPerson" type="eSDScom:EmailAddress">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation>Email address of the competent person responsible for the safety data sheet.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element minOccurs="0" name="Duns" type="eSDScom:DunsNo">
							<xs:annotation>
								<xs:documentation> The D-U-N-S Number references a legal entity and allows access to what could be considered a self-maintaining address book, created for the automotive and chemical industry. It should be added to any address in SDScom to help data integration. See also https://www.upik.de/ </xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="unbounded" minOccurs="0" name="EmergencyPhone">
				<xs:annotation>
					<xs:appinfo>SDScomBau</xs:appinfo>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation> Emergency phone: Contacts that can be used in case of an accident or trouble, e.g. the supplier’s own emergency phone or the phone number to an official advisory body. A Poison Information Center gives advice and instruction regarding treatment of acute poisoning caused by chemicals etc. </xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element minOccurs="0" name="No" type="eSDScom:string256">
							<xs:annotation>
								<xs:appinfo>SDScomBau</xs:appinfo>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation> Telephone number: </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="EmergencyPhoneDescription" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:appinfo>SDScomBau</xs:appinfo>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation> Information: This field is used to state what kind of assistance that can be obtained from the actual emergency telephone, if it is available only during office hours, etc. </xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SubstanceNames">
		<xs:sequence>
			<xs:element name="IupacName" type="eSDScom:string1024" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:appinfo>SDScomBau</xs:appinfo>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation>IUPAC or chemical name</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="CasInventoryName" type="eSDScom:string1024">
				<xs:annotation>
					<xs:documentation>a.k.a CAIN, Name in the CAS Online Inventory</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GenericName" type="eSDScom:string1024" minOccurs="0">
				<xs:annotation>
					<xs:appinfo>SDScomBau</xs:appinfo>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation>Alternative chemical name to protect Confidential Business Information (in Europe, according to CLP article 24)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OtherName" type="eSDScom:string1024" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:appinfo>SDScomBau</xs:appinfo>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation>Includes trade name(s) of the chemical that appear on the packages / hazard label.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SubstanceIdentifiers">
		<xs:complexContent>
			<xs:extension base="eSDScom:SubstanceNames">
				<xs:sequence>
					<xs:element name="CasNo" type="eSDScom:CasNo" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:appinfo>SDScomBau</xs:appinfo>
							<xs:appinfo>SDScomChem</xs:appinfo>
							<xs:documentation>CAS RN: Registration Number for chemical substances, including some groups and more complex cases like polymers and reaction products, issued by Chemical Abstract Service. For a discussion why there is just one CAS RN per substance, see issue #111.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="RegionEU" type="eSDScom:SubstanceIdentityEU">
						<xs:annotation>
							<xs:documentation>Region-specific information in the area of substance/mixture and supplier identification; jurisdiction follows from the field name.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="Substance">
		<xs:annotation>
			<xs:documentation>Substance information. Includes identifiers (for section 1 in substance SDSs) as well as chemical inventory listing informaton (for section 15). Chemical inventory information is useful even if the data does not cover all regions, in case the customer wants to export to other regions.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="eSDScom:SubstanceIdentifiers">
				<xs:sequence>
					<xs:element name="Formula" minOccurs="0" maxOccurs="1" type="eSDScom:string256">
						<xs:annotation>
							<xs:documentation>Field to specify the sum formula for the chemical (applies to pure substances). </xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element minOccurs="0" name="StructureFormula">
						<xs:complexType>
							<xs:sequence>
								<xs:element minOccurs="0" name="Smiles" type="eSDScom:string256">
									<xs:annotation>
										<xs:documentation>SMILES Notation = Simplified Molecular Input Line Entry System.</xs:documentation>
									</xs:annotation>
								</xs:element>
								<xs:element minOccurs="0" name="Inchi" type="eSDScom:string1024">
									<xs:annotation>
										<xs:documentation>InChI = International Chemical Identifier. Unique identifier for each substance.</xs:documentation>
									</xs:annotation>
								</xs:element>
								<xs:element minOccurs="0" name="InchiKey" type="eSDScom:InchiKey">
									<xs:annotation>
										<xs:documentation>InChI Hash Key</xs:documentation>
									</xs:annotation>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element minOccurs="0" name="SubstanceType" type="eSDScom:SubstanceTypeEnum"/>
					<xs:element name="SubstanceTypeDescription" type="eSDScom:Phrase" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:appinfo>SDScomChem</xs:appinfo>
							<xs:documentation>If SubstanceType is other (or not used), specify the details here.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="MolecularWeight" type="eSDScom:NumericRangeWithUnitAndQualifier" minOccurs="0"/>
					<xs:element name="ChemicalPurity" type="eSDScom:Phrase" minOccurs="0" maxOccurs="unbounded"/>
					<xs:element minOccurs="0" name="Inventories" type="eSDScom:Inventories">
						<xs:annotation>
							<xs:documentation>Inventories are not part of the regional regulatory information and bundled under this element because product recipients may want to distribute to other markets, in which case the inventory information is helpful even if the SDS does not cover the target market.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<!-- ******************************************************************* EcologicalInformation ************  -->
	<xs:complexType name="ToxInfoStotSE3">
		<xs:sequence>
			<xs:element name="HumanExperience" type="eSDScom:Phrase" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Source" type="eSDScom:Phrase" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="AssessmentOrClassification" type="eSDScom:Phrase" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Assessment or classification eines Effekts or endpoints.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AdditionalInfo" type="eSDScom:Phrase" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>E.g. how the evaluation took place or why data is lacking. See EuPhraC for content examples.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!-- *******************************************************************  OccupationalExposureLimit *************  -->
	<xs:complexType name="Classification">
		<xs:sequence>
			<xs:element minOccurs="0" name="RegionEU" type="eSDScom:ClassificationEU"> </xs:element>
			<xs:element name="RegionUS" type="eSDScom:ClassificationUS"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AteValue">
		<xs:annotation>
			<xs:documentation>Acute Toxicity Estimates for mixture-in-mixture classification.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element maxOccurs="1" name="Value" type="float">
				<xs:annotation>
					<xs:documentation>Numeric value as floating-point number; unit follows from context or associated unit field.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:group ref="eSDScom:Unit"/>
			<xs:element maxOccurs="unbounded" minOccurs="0" name="Restriction" type="eSDScom:Phrase">
				<xs:annotation>
					<xs:documentation>e.g. "dust or mist"</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:group name="ClassCategoryInfo">
		<xs:annotation>
			<xs:documentation>Group for additional info per class/category entry, see #272</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element maxOccurs="1" name="HazardClassCategoryPrintable" type="eSDScom:Phrase">
				<xs:annotation>
					<xs:appinfo>SDScomBau</xs:appinfo>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation>Printable, phrase based representation of HazardClassCategory. While this may be identical to HazardClassCatgory in its string representation, it provides a translated version linked to a phrase library for applications where this is useful.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element maxOccurs="unbounded" minOccurs="0" name="Organ" type="eSDScom:Phrase">
				<xs:annotation>
					<xs:documentation>For Sepcific Target Organ Toxicity (STOT), one or more affected organs should be listed if known.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element maxOccurs="unbounded" minOccurs="0" name="ExposureRoute" type="eSDScom:Phrase">
				<xs:annotation>
					<xs:documentation>For Specific Target Organ Toxicity (STOT), the entry can be limited to a way of exposure (e.g. inhalation). Although there is currently no known case with more than one route of exposure, we cannot exclude this biologically and thus technically.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="ClassificationProcedure" type="eSDScom:Phrase">
				<xs:annotation>
					<xs:documentation>To state how the individual classification is prepared. (This information should be shown in section 16). Only relevant for instances of type Classification in section 2. For components in section 3, this info should not be part of the SDS.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:group>
	<xs:group name="ClassificationInfo">
		<xs:annotation>
			<xs:documentation>Group for additional info per classification (set of classes/category for one product)</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element minOccurs="0" name="UnknownToxicity">
				<xs:annotation>
					<xs:documentation>Fraction or indication of unknown toxicity; typically expressed as % with explanatory text.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element minOccurs="0" name="Inhalation" type="eSDScom:Percentage">
							<xs:annotation>
								<xs:documentation>Information on inhalation exposure or toxicity; typically expressed as % with explanatory text where applicable.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element minOccurs="0" name="Dermal" type="eSDScom:Percentage">
							<xs:annotation>
								<xs:documentation>Information on dermal exposure or toxicity; typically expressed as % with explanatory text where applicable.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element minOccurs="0" name="Oral" type="eSDScom:Percentage">
							<xs:annotation>
								<xs:documentation>Information on oral exposure or toxicity; typically expressed as % with explanatory text where applicable.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element minOccurs="0" name="Aquatic" type="eSDScom:Percentage">
							<xs:annotation>
								<xs:documentation>Information on unknown aquatic toxicity; typically expressed as % with explanatory text.</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element minOccurs="0" name="Ate">
				<xs:annotation>
					<xs:documentation>Acute Toxicity Estimate as provided by the supplier. Necessary according to UN GHS if the mixture is ingredient of another mixture, to derive this product's toxicity classification. In CLP, ATE values may also be specified in harmonized classifications (CLP Annex VI)</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element minOccurs="0" name="Inhalation" type="eSDScom:AteValue"> </xs:element>
						<xs:element minOccurs="0" name="Dermal" type="eSDScom:AteValue"> </xs:element>
						<xs:element minOccurs="0" name="Oral" type="eSDScom:AteValue"> </xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInformation" type="eSDScom:Phrase">
				<xs:annotation>
					<xs:appinfo>SDScomBau</xs:appinfo>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation> Additional information on classification: If the chemical do not meet the classification criteria etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:group>
	<xs:complexType name="OccupationalExposureLimit">
		<xs:annotation>
			<xs:documentation>see Github issue #116 regarding multiple limit values</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="LimitValueTypeWithCountryOrOrganisation" type="eSDScom:ExposureLimitValueTypeEnum" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>type of limit value with country or organisation, e.g. AGW (DE), IOELV (EU) or MAK.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Limit8H" type="eSDScom:NumericRangeWithUnitAndQualifier" minOccurs="0" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>If two occurences, one must be ppm and the other a matching mg/m3 value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LimitShortTerm" type="eSDScom:STEL" minOccurs="0" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>If two occurences, one must be ppm and the other a matching mg/m3 value.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PeakLimitation" minOccurs="0" maxOccurs="2">
				<xs:annotation>
					<xs:documentation>Also known as ceiling value. If two occurences, one must be ppm and the other a matching mg/m3 value. One of Value and PeakLimitationOverflowFactor is sufficient. If both are given, Value must be the short-term Value multiplied with the overflow factor.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Value" type="eSDScom:NumericRangeWithUnitAndQualifier" minOccurs="0" maxOccurs="1"/>
						<xs:element name="PeakLimitationOverflowFactor" type="eSDScom:NumericRangeWithQualifier" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>Peak limitation overflow factor for short-term exposure limits; dimensionless factor.</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="RecommendedMonitoringProcedure" type="eSDScom:Phrase" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Recommended measurement or monitoring procedure for relevant exposures.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element minOccurs="0" name="ParticleFraction">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="ParticleFraction" type="eSDScom:ExposureLimitFractionEnum">
							<xs:annotation>
								<xs:documentation>Particle fraction for occupational exposure limits, e.g. inhalable or respirable.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element minOccurs="0" name="ParticleFractionFulltext" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>full text designation of the particle fraction, e.g. inhalable dust fraction.</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Reference" type="eSDScom:Phrase" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Source or reference for limit values, tests or data; bibliographic or URL.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AdditionalInfo" type="eSDScom:Phrase" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A remark that applies to all of the abovementioned OELs. Can cover specific info like code letters (H, Sh, Sa, Y, Z in Germany's TRGS 900) either as the letter or as the respective explanatory text. If there are multiple limit values depending on conditions described in remarks (e.g. dust and spray values), use multiple instances of OccupationalExposueLimit - ofr example, two instances for inhalable and respirable fraction OEL's.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!-- *******************************************************************  BiologicalLimitValue *************  -->
