								<xs:documentation>Description of colour intensity or colour characteristic.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element minOccurs="0" name="Odour" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation> Product odour: Description of the smell of the product. </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element minOccurs="0" name="OdourThreshold" type="eSDScom:PhysChemUnitValueWithTemperature">
							<xs:annotation>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation>Odour threshold; unit typically mg/m³, ppm or qualitative information.</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
