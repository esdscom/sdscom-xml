					<xs:sequence>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="CarcinogenicityTestResults" type="eSDScom:CMRData">
							<xs:annotation>
								<xs:documentation>Test results on carcinogenicity; study, species and endpoint.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="CarcinogenicityHumanExperience" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>Human experience on carcinogenicity; qualitative or epidemiological information.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AssessmentCarcinogenicityClassification" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>Classification assessment for carcinogenicity under CLP/GHS.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="unbounded" minOccurs="0" name="ReproductiveToxicity">
				<xs:annotation>
					<xs:documentation>Can have one instance for each ReproductiveToxicityType</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element minOccurs="0" name="ReproductiveToxicityType">
							<xs:annotation>
								<xs:documentation>type of reproductive toxicity, e.g. fertility, development or lactation.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Type" type="eSDScom:ReproductiveToxicityTypeEnum">
										<xs:annotation>
											<xs:documentation>Coded type of reproductive toxicity.</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="TypeFulltext" type="eSDScom:Phrase"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="ReproductiveToxicityTestResults" type="eSDScom:CMRData">
							<xs:annotation>
								<xs:documentation>Test results for reproductive toxicity.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="ReproductiveToxicityHumanExperience" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>Human experience for reproductive toxicity.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AssessmentReproductiveToxicityClassification" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>Assessment of classification for reproductive toxicity under CLP/GHS.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="unbounded" minOccurs="0" name="OverallAssessmentOnCMRProperties" type="eSDScom:Phrase">
				<xs:annotation>
					<xs:documentation>Overall assessment of CMR properties: carcinogenicity, mutagenicity, reproductive toxicity.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="SpecificTargetOrganSE">
				<xs:annotation>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation>Specific target organ toxicity following single exposure (STOT SE).</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="SpecificTargetOrganSETestResults" type="eSDScom:STOTData">
							<xs:annotation>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation>Test results on STOT SE (specific target organ toxicity following single exposure).</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="1" minOccurs="0" name="SpecificTargetOrganSEHumanExperience" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>Human experience for STOT SE (specific target organ toxicity following single exposure).</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AssessmentSpecificTargetOrganSEClassification" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>Classification assessment for STOT SE (specific target organ toxicity following single exposure) under CLP/GHS.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="SpecificTargetOrganSE3">
				<xs:annotation>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation>separate from SpecificTargetOrganSE3 because classified independently STOT SE data in section 11 does not cover the data on narcotic effects (H336) and irritation to the respriratory tract (H335) which is correctly represented in the classification structure. STOT-SE Category 3 includes only respiratory tract irritation (sore throat, cough) and narcotic effects (dizziness, drowsiness).</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="IrritationToRespiratoryTract" type="eSDScom:ToxInfoStotSE3" minOccurs="0">
							<xs:annotation>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation>Respiratory tract irritation in the STOT SE 3 (specific target organ toxicity following single exposure) context.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="NarcoticEffects" type="eSDScom:ToxInfoStotSE3" minOccurs="0">
							<xs:annotation>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation>Narcotic effects in the STOT SE 3 (specific target organ toxicity following single exposure) context.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="SpecificTargetOrganSETestResults" type="eSDScom:STOTData">
							<xs:annotation>
								<xs:appinfo>SDScomChem</xs:appinfo>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AssessmentSpecificTargetOrganSEClassification" type="eSDScom:Phrase"/>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="SpecificTargetOrganRE">
				<xs:annotation>
					<xs:appinfo>SDScomChem</xs:appinfo>
					<xs:documentation>Specific target organ toxicity following repeated exposure (STOT RE).</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="SpecificTargetOrganRETestResults" type="eSDScom:STOTData">
							<xs:annotation>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation>Test results on STOT RE (specific target organ toxicity repeated exposure).</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="1" minOccurs="0" name="SpecificTargetOrganREHumanExperience" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>Human experience for STOT RE (specific target organ toxicity repeated exposure).</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AssessmentSpecificTargetOrganREClassification" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>Classification assessment for STOT RE (specific target organ toxicity repeated exposure) under CLP/GHS.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element maxOccurs="1" minOccurs="0" name="AspirationHazard">
				<xs:annotation>
					<xs:documentation>Assessment of aspiration hazard under CLP/GHS.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element maxOccurs="1" minOccurs="0" name="TestReference" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>AspirationHazard is based on human experience only, thus there are no test results. This field covers a reference to the source (otherwise named TestReference, which is adopted here for consistency).</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="1" minOccurs="0" name="AspirationHazardHydrocarbonContent" type="eSDScom:NumericRangeWithUnitAndQualifier">
							<xs:annotation>
								<xs:documentation> Aspiration hazard hydrocarbon content: Concentration of hydrocarbons in the mixture with a kinematic viscosity of 20,5 mm2/s or less, measured at 40 C. </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element minOccurs="0" name="AspirationHazardKinematicViscosity40" type="eSDScom:NumericRangeWithUnitAndQualifier">
							<xs:annotation>
								<xs:documentation>Kinematic viscosity value at 40°C</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AssessmentAspirationHazardClassification" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:documentation>Classification assessment for aspiration hazard under CLP/GHS.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
