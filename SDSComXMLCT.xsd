							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="FormDescription" type="eSDScom:Phrase">
							<xs:annotation>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation>Indicate the form (solid, liquid, gas or other descriptive terms) of the substance or mixture as supplied. May be omitted if specified in field Form. If Form is "other", put more details in this field.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element minOccurs="0" name="StateUnderStandardConditions" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Physical state under standard conditions; gas, liquid or solid.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="State" type="eSDScom:StateUnderStandardConditionsEnum">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
											<xs:documentation>Physical state (only solid/liquid/gaseous) under standard conditions (20°C, 1013 hpa) </xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element minOccurs="0" name="StateFulltext" type="eSDScom:Phrase">
										<xs:annotation>
											<xs:documentation>Physical state under standard conditions.</xs:documentation>
										</xs:annotation>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="Colour" type="eSDScom:ColourEnum">
							<xs:annotation>
								<xs:documentation>Multiple entries (only) in case of "multicolour" and "colouring agent"</xs:documentation>
							</xs:annotation>
						</xs:element>
