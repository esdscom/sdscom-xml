							<xs:annotation>
								<xs:appinfo>SDScomChem</xs:appinfo>
								<xs:documentation>Product colour: Indicate the colour of the substance or preparation as supplied. May be omitted if Colour is used. This field is also used if none of ColourEnum matches.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element minOccurs="0" name="ColourIntensity" type="eSDScom:ColourIntensityEnum" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Colour intensity of the product; qualitative information.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element maxOccurs="unbounded" minOccurs="0" name="ColourIntensityDescription" type="eSDScom:Phrase">
