										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
										</xs:annotation>
									</xs:element>
									<xs:element maxOccurs="1" minOccurs="1" name="Species" type="eSDScom:Species">
										<xs:annotation>
											<xs:appinfo>SDScomChem</xs:appinfo>
