<xs:schema targetNamespace="http://www.esdscom.eu/eSDScom" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:eSDScom="http://www.esdscom.eu/eSDScom" xmlns:xs="http://www.w3.org/2001/XMLSchema" version="5.6">
    <xs:include schemaLocation="SDSComXMLDT.xsd"/>
    <xs:include schemaLocation="SDSComXMLCT.xsd"/>
    <xs:simpleType name="Gbt2009ClassCategoryEnum">
        <xs:union memberTypes="eSDScom:Whmis2015ClassCategoryEnumRestr eSDScom:Whmis2015ClassCategoryEnumExt"/>
    </xs:simpleType>
    <xs:complexType name="ClassificationCN">
        <xs:sequence>
            <xs:element minOccurs="0" name="Gbt2009HazardClassification">
                <xs:complexType>
                    <xs:sequence>
                        <xs:sequence maxOccurs="unbounded" minOccurs="0">
                            <xs:element maxOccurs="1" minOccurs="1" name="HazardClassCategory" type="eSDScom:Gbt2009ClassCategoryEnum"> </xs:element>
                            <xs:group ref="eSDScom:ClassCategoryInfo"/>
                        </xs:sequence>
                        <xs:group ref="eSDScom:ClassificationInfo"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="HazardLabellingCN"/>
    <xs:complexType name="ComponentCN">
        <xs:complexContent>
            <xs:extension base="eSDScom:Component">
                <xs:sequence>
                    <xs:element minOccurs="0" name="Classification" type="eSDScom:ClassificationCN"> </xs:element>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="TransportCN">
        <xs:sequence>
            <xs:element minOccurs="0" name="UnNo" type="eSDScom:int4"> </xs:element>
            <xs:element minOccurs="0" name="ProperShippingName" type="eSDScom:Phrase"> </xs:element>
            <xs:element maxOccurs="unbounded" minOccurs="0" name="DangerReleasingSubstance" type="eSDScom:Phrase"> </xs:element>
            <xs:element minOccurs="0" name="Class" type="eSDScom:TransportClassEnum"> </xs:element>
            <xs:element name="ClassCode" minOccurs="0" type="eSDScom:string4"/>
            <xs:element minOccurs="0" name="PackingGroup" type="eSDScom:PackingGroupEnum"/>
            <xs:element maxOccurs="3" minOccurs="0" name="Placard" type="eSDScom:TransportClassEnum"/>
            <xs:element minOccurs="0" name="OtherInformation">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element maxOccurs="unbounded" minOccurs="0" name="SpecialProvisions" type="eSDScom:string80"/>
                        <xs:element maxOccurs="1" minOccurs="0" name="LimitedQty" type="eSDScom:string20">
                            <xs:annotation>
                                <xs:documentation>may have a value like "500 mL or 500 g"</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element minOccurs="0" name="ExceptedQty" type="eSDScom:TransportEq"/>
                        <xs:element maxOccurs="unbounded" minOccurs="0" name="AdditionalInfo" type="eSDScom:Phrase"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="RegulationsCN">
        <xs:annotation>
            <xs:documentation>Regulations valid for the product of mixture as a whole. For ingredient information, refer to type ComponentCN.</xs:documentation>
        </xs:annotation>
        <xs:sequence> </xs:sequence>
    </xs:complexType>
</xs:schema>
